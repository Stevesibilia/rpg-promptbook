# Copy to .env (ignored by git) before `docker compose up`.

# The port on this machine; the app answers at http://localhost:<port>.
PROMPTBOOK_PORT=8090

# The address the app is opened at, http://localhost:<port> when unset. The app
# accepts writes and sync only from this origin, so to reach the stack from
# other devices on the LAN set it to this machine's LAN address and open it at
# that address everywhere, this machine included.
# PUBLIC_URL=http://<this machine's LAN address>:8090

# The first account, created when the database has none. The password needs
# at least 12 characters. Once an account exists these are ignored; use
# `docker compose exec app node dist/cli.js user:password <username>` instead.
PROMPTBOOK_ADMIN_USERNAME=steve
PROMPTBOOK_ADMIN_PASSWORD=change-this-password

# The database password, used only inside the stack.
POSTGRES_PASSWORD=promptbook

# Image generation: the key the server seals each account's OpenRouter key
# with, the base64 of 32 random bytes. Make one with
#   openssl rand -base64 32
# and keep it: another key makes every saved OpenRouter key unreadable, so each
# account saves its key again in Settings → Image generation. Unset: image
# generation is off.
# PROMPTBOOK_SECRETS_KEY=

# OpenRouter's API, https://openrouter.ai/api/v1 when unset. The end-to-end
# stack points it at a fake OpenRouter (e2e/compose.openrouter.yaml); for a
# preview against the fake, add that file to `docker compose -f` and set
# OPENROUTER_BASE_URL=http://openrouter:8099/api/v1
# OPENROUTER_BASE_URL=

# Atelier's address, http or https, for generating through Atelier as well as
# OpenRouter; it needs PROMPTBOOK_SECRETS_KEY too. Unset: Atelier is
# unavailable. The end-to-end stack points it at a fake Atelier
# (e2e/compose.atelier.yaml); for a preview against the fake, add that file to
# `docker compose -f` and set ATELIER_URL=http://atelier:8098
# ATELIER_URL=
